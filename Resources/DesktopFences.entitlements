<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required under the hardened runtime for the app to send Apple Events
	     to Finder. Without it the events are blocked before TCC is consulted,
	     so macOS never shows the consent prompt and the app never appears in
	     System Settings > Privacy & Security > Automation. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
